### Sports Court Management — Auth API Tests
### Base URL: http://localhost:5203/api
### Swagger UI: http://localhost:5203

@baseUrl = http://localhost:5203/api

###############################################################################
# 1. REGISTER — Đăng ký tài khoản mới
# Sau khi gọi thành công, kiểm tra Console backend để lấy mã OTP 6 chữ số.
###############################################################################
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName":        "Nguyễn Văn Test",
  "email":           "test@gmail.com",
  "phone":           "0901234567",
  "password":        "Test@123456",
  "confirmPassword": "Test@123456"
}

###############################################################################
# 2. VERIFY EMAIL — Nhập mã OTP để kích hoạt tài khoản
# Thay thế "123456" bằng mã OTP thực tế từ Console / Email.
###############################################################################
POST {{baseUrl}}/auth/verify-email
Content-Type: application/json

{
  "email": "test@gmail.com",
  "otp":   "123456"
}

###############################################################################
# 3. LOGIN — Đăng nhập và nhận Access + Refresh Token
###############################################################################
# @name loginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email":    "test@gmail.com",
  "password": "Test@123456"
}

###############################################################################
# 4. ME — Lấy thông tin người dùng hiện tại (cần Access Token)
# Sao chép accessToken từ response của bước 3 vào đây.
###############################################################################
@accessToken = PASTE_ACCESS_TOKEN_HERE

GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

###############################################################################
# 5. REFRESH TOKEN — Làm mới cặp token
# Sao chép accessToken + refreshToken từ response của bước 3.
###############################################################################
@refreshToken = PASTE_REFRESH_TOKEN_HERE

POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json

{
  "accessToken":  "{{accessToken}}",
  "refreshToken": "{{refreshToken}}"
}

###############################################################################
# 6. LOGOUT — Đăng xuất, xóa Refresh Token trong DB
###############################################################################
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

###############################################################################
# 7. LOGIN với tài khoản Admin đã seed sẵn
###############################################################################
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email":    "admin@sportscourtms.vn",
  "password": "Admin@123"
}

###############################################################################
# 8. TEST PHÂN QUYỀN — Dùng token Customer truy cập endpoint Admin
# Phải nhận lại 403 Forbidden
###############################################################################
GET {{baseUrl}}/users/customers
Authorization: Bearer {{accessToken}}
